# Paths are anchored with a leading slash on purpose. A bare "logs/" matches a
# directory of that name at ANY depth: it silently excluded src/app/api/logs/
# and shipped a repo whose dashboard had no activity feed. Same trap applied to
# exports/, resumes/, screenshots/ and build/.
/node_modules/
/.next/
/out/
/build/
*.tsbuildinfo
next-env.d.ts

.env
.env.local
.env*.local

# Runtime state. The database, uploaded resumes, tailored PDFs, screenshots,
# browser profiles, exports and logs all live under data/, so one rule covers
# them and none of it can collide with a source directory.
/data/
!/data/.gitkeep
*.db
*.db-journal
*.sqlite

.DS_Store
