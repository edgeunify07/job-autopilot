# ---- required ----------------------------------------------------------
# Get one at https://console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-...

# Any random string, 16+ chars. Encrypts anything sensitive stored on disk.
APP_SECRET=change-me-to-something-long-and-random

DATABASE_URL="file:./data/autopilot.db"

# ---- optional ----------------------------------------------------------
# Tailoring, cover letters, form answers (judgement work).
ANTHROPIC_MODEL=claude-opus-5-5
# Scoring hundreds of jobs (bulk work, cheap model).
ANTHROPIC_BULK_MODEL=claude-haiku-5-5

# false = you can watch the browser and step in for captchas and OTPs.
# Set this to false the first time you use a portal so you can log in.
HEADLESS=true

# Where the database, resumes, screenshots and exports live.
DATA_DIR=./data

TZ_NAME=Asia/Kolkata
